(defpoll notes_text :interval "300s"
  "grep -vE '^(#|$)' /home/simon/.config/eww/sticker/notes.txt 2>/dev/null || echo 'No notes yet...'")

(defwindow notes
  :monitor 0
  :stacking "bottom"
  :focusable false
  :exclusive false
  :geometry (geometry :x '16px' :y '16px' :anchor 'top left')
  (box :class "notesbox" :width 420
    (button
      :onclick "sh -c '~/.config/eww/sticker/open-notes.sh'" ;"sh -c 'hyprctl dispatch exec \"kitty --class notesedit -e sh -lc \\\"nano ~/.config/eww/sticker/notes.txt\\\"\"'"
      (label
        :class "notes"
        :text notes_text
        :wrap true
        :ellipsize "none"
        :halign "start" :valign "end"
        :xalign 0 :yalign 1))))
