(defvar notes_text "No notes yet...")

(defwindow notes
  :monitor 0
  :stacking "bottom"
  :focusable false
  :exclusive false
  :geometry (geometry :x '16px' :y '16px' :anchor 'top left')
  (box :class "notesbox" :width 420
    (button
      :onclick "lua ~/.config/eww/sticker/open-notes.lua" ;"sh -c 'hyprctl dispatch exec \"kitty --class notesedit -e sh -lc \\\"nano ~/.config/eww/sticker/notes.txt\\\"\"'"
      (label
        :class "notes"
        :text notes_text
        :wrap true
        :ellipsize "none"
        :halign "start" :valign "end"
        :xalign 0 :yalign 1))))
